+// mod-classic-classes: the classic classes take the Character Advancement requests (buying, unlearning) like the CoA classes.
+bool IsClassicClassOnRealm(Player const *player) {
+  uint8 playerClass = player->getClass();
+  if (!sConfigMgr->GetOption<bool>("ClassicClasses.Enable", false, false))
+    return false;
+  return (playerClass >= CLASS_WARRIOR && playerClass <= CLASS_WARLOCK) || playerClass == CLASS_DRUID;
+}
